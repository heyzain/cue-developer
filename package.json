{
  "name": "cue-developer-launcher",
  "version": "0.3.0",
  "private": true,
  "description": "A warm editorial-style, local-first developer tool launcher for Windows, macOS and Linux.",
  "author": "Cue",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "dist:win": "electron-builder --win nsis",
    "dist:portable": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "45.3.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.cue.devlauncher",
    "productName": "Cue",
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "styles.css",
      "renderer.js",
      "seed.js",
      "assets/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "icon": "assets/cue.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
